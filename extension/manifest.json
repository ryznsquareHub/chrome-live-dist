{
  "manifest_version": 3,
  "name": "chrome-live 작업 기록",
  "version": "2.1.0",
  "description": "chrome-live(Claude)가 크롬에서 한 일을 오른쪽 사이드 패널에 시간순으로 보여 주고, 연결 끊기/다시 연결 버튼을 제공합니다.",
  "key": "",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:18932/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "chrome-live 작업 기록 열기"
  }
}
